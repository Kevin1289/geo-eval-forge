# Copy to .env and adjust. The offline pipeline needs none of these.

# --- PostGIS (live stack) ---
POSTGRES_DB=geoeval
POSTGRES_USER=geoeval
POSTGRES_PASSWORD=geoeval
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- GeoServer (live stack) ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_URL=http://geoserver:8080/geoserver

# --- Vertex AI (optional live LLM adapter for baselines / judge) ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GEOEVAL_VERTEX_MODEL=gemini-2.5-pro
